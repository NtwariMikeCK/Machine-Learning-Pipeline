# ─── Google Drive Integration ────────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# The API server reads these at startup via os.getenv().
#
# How to get the folder IDs:
#   Open the folder in Google Drive → copy the last part of the URL
#   e.g. https://drive.google.com/drive/folders/1ABCxyz...  →  1ABCxyz...

# Folder where trained models (.keras / .h5 + sidecar JSONs) are stored.
GDRIVE_MODELS_FOLDER_ID=1j02vAV1ol8JKQsrDr2LF1T8b5MCXDb-x

# Folder where new-data ZIPs uploaded from the frontend are placed.
# The Colab retrain notebook reads from this folder.
GDRIVE_NEWDATA_FOLDER_ID=1-nwigPt6GfEdTg4F6ts0-t-lJhJDKZT1

# Path to the service-account JSON credentials file.
# Default: credentials/gdrive_service_account.json
GDRIVE_CREDENTIALS_PATH=credentials/gdrive_service_account.json


# ─── Quick setup checklist ────────────────────────────────────────────────────
#
# 1. Go to https://console.cloud.google.com/
#    → APIs & Services → Library → Enable "Google Drive API"
#
# 2. APIs & Services → Credentials → Create Credentials → Service Account
#    → give it a name → Done
#    → click the new service account → Keys tab → Add Key → JSON
#    → save the downloaded file as:  credentials/gdrive_service_account.json
#
# 3. Note the service-account email (looks like name@project.iam.gserviceaccount.com)
#
# 4. In Google Drive, create two folders:
#      MLPipeline/models    ← trained model files
#      MLPipeline/new_data  ← uploaded training ZIPs
#
# 5. Right-click each folder → Share → paste the service-account email
#    → set role to "Editor" → Share
#
# 6. Copy each folder's ID into the variables above.
#
# 7. Install dependencies:
#    pip install google-api-python-client google-auth google-auth-httplib2
#
# 8. Start the server:
#    uvicorn prediction:app --host 0.0.0.0 --port 8000 --reload
